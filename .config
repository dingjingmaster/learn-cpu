
#
# 工具链探测
#
CONFIG_COMPILER_TYPE="GCC"
CONFIG_CC_IS_GCC=y

#
# 未找到 Emscripten；如需 WebAssembly 构建，请安装 emsdk
#
# end of 工具链探测

#
# 构建目标
#
CONFIG_BUILD_NATIVE=y

#
# 当前构建模式：本地程序
#
# end of 构建目标

CONFIG_HAVE_SDL2=y
CONFIG_HAVE_SDL2_MIXER=y

#
# RISC-V ISA 配置
#
CONFIG_RV32I=y
# CONFIG_RV32E is not set

#
# 标准扩展
#
CONFIG_EXT_M=y
CONFIG_EXT_A=y
CONFIG_EXT_F=y
CONFIG_EXT_C=y

#
# Zicsr 和 Zifencei 扩展
#
CONFIG_Zicsr=y
CONFIG_Zifencei=y

#
# 位操作扩展（Zb*）
#
CONFIG_Zba=y
CONFIG_Zbb=y
CONFIG_Zbc=y
CONFIG_Zbs=y
# end of RISC-V ISA 配置

#
# 执行模式
#

#
# 模拟方式
#
CONFIG_INTERPRETER_ONLY=y
# CONFIG_JIT is not set

#
# 系统模拟
#
# CONFIG_SYSTEM is not set
# end of 执行模式

#
# 性能选项
#
CONFIG_MOP_FUSION=y
CONFIG_BLOCK_CHAINING=y
CONFIG_LTO=y
# end of 性能选项

#
# 调试
#
# CONFIG_GDBSTUB is not set
CONFIG_LOG_COLOR=y
# CONFIG_UBSAN is not set
# end of 调试

#
# 图形和音频
#
CONFIG_SDL=y
CONFIG_SDL_MIXER=y
# end of 图形和音频

#
# 测试
#
# CONFIG_ARCH_TEST is not set
# end of 测试

#
# 构建选项
#
CONFIG_OPTIMIZE_LEVEL=2
# CONFIG_OPTIMIZE_SIZE is not set
# CONFIG_DEBUG_SYMBOLS is not set
# end of 构建选项

CONFIG_CONFIGURED=y
